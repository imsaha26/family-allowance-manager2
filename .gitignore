# ============================================================
# Family Allowance Manager — .gitignore
# ============================================================

# ────────────────────────────────────────────────────────────
# Environment & Secrets (NEVER commit)
# ────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
*.pem
*.key
*.secret
secrets/

# ────────────────────────────────────────────────────────────
# Rust / Cargo / Soroban
# ────────────────────────────────────────────────────────────
target/
**/*.rs.bk
Cargo.lock
# Keep workspace Cargo.lock for reproducibility (remove next line if desired)
# Cargo.lock

# Soroban WASM build artifacts
*.wasm
*.wat
*.d    # dependency files in release build

# Stellar CLI identity files (keep out of repo)
.stellar/

# ────────────────────────────────────────────────────────────
# Node.js / npm / pnpm / yarn
# ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Build outputs
.next/
out/
dist/
build/

# Cache
.cache/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts

# Testing
coverage/
.nyc_output/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ────────────────────────────────────────────────────────────
# Generated contract bindings (regenerated on deploy)
# ────────────────────────────────────────────────────────────
packages/family_registry/
packages/allowance_distributor/

# ────────────────────────────────────────────────────────────
# OS & Editor artifacts
# ────────────────────────────────────────────────────────────

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains IDEs
.idea/
*.iml
*.iws

# Vim/Neovim
*.swp
*.swo
.netrwhist

# ────────────────────────────────────────────────────────────
# Deployment & CI artifacts
# ────────────────────────────────────────────────────────────
.vercel/
deploy-output/
*.zip
*.tar.gz

# Script temp outputs
scripts/output/
scripts/*.tmp
scripts/deployed-contracts.json

# ────────────────────────────────────────────────────────────
# Docker
# ────────────────────────────────────────────────────────────
.docker/
docker-compose.override.yml

# ────────────────────────────────────────────────────────────
# Misc
# ────────────────────────────────────────────────────────────
*.bak
*.orig
*.tmp
