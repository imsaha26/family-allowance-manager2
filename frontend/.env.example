# ============================================================
# Family Allowance Manager — Frontend Environment Variables
# Copy this file to .env or .env.local inside this folder
# ============================================================

# Network configuration
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet

# Deployed Contract Addresses (replace with actual IDs after deployment)
NEXT_PUBLIC_FAMILY_REGISTRY_CONTRACT_ID=REPLACE_AFTER_DEPLOYMENT
NEXT_PUBLIC_ALLOWANCE_DISTRIBUTOR_CONTRACT_ID=REPLACE_AFTER_DEPLOYMENT
NEXT_PUBLIC_XLM_SAC_CONTRACT_ID=CDW472K2OI757GE2J74SNF2533Z2IE4J3325SNF2533Z2IE4J3325SNF2

# UI Features configuration
NEXT_PUBLIC_ENABLED_WALLETS=freighter,xbull,lobstr,hana
NEXT_PUBLIC_ENABLE_ACTIVITY_FEED=true
NEXT_PUBLIC_ACTIVITY_POLL_INTERVAL_MS=5000
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_SAVINGS_GOALS=true

# Next.js App configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Family Allowance Manager"
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SENTRY_DSN=
