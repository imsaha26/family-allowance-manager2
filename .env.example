# ============================================================
# Family Allowance Manager — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================


# ────────────────────────────────────────────────────────────
# Stellar Network Configuration
# ────────────────────────────────────────────────────────────

# Network selection: "local", "testnet", or "mainnet"
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Testnet network passphrase (do not change for testnet)
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Mainnet passphrase (use only for production)
# NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"

# Soroban RPC endpoint
# Testnet (default SDF endpoint):
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Local Quickstart node:
# NEXT_PUBLIC_SOROBAN_RPC_URL=http://localhost:8000/soroban/rpc

# Horizon API (used for account info + trustlines)
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# ────────────────────────────────────────────────────────────
# Deployed Soroban Contract Addresses
# Populated after running scripts/deploy-testnet.sh
# ────────────────────────────────────────────────────────────

# family_registry contract address (C...)
NEXT_PUBLIC_FAMILY_REGISTRY_CONTRACT_ID=REPLACE_AFTER_DEPLOYMENT

# allowance_distributor contract address (C...)
NEXT_PUBLIC_ALLOWANCE_DISTRIBUTOR_CONTRACT_ID=REPLACE_AFTER_DEPLOYMENT

# Stellar Asset Contract for native XLM (deterministic address)
# Retrieve with: stellar contract id asset --asset native --network testnet
NEXT_PUBLIC_XLM_SAC_CONTRACT_ID=REPLACE_AFTER_DEPLOYMENT

# ────────────────────────────────────────────────────────────
# Stellar Explorer
# ────────────────────────────────────────────────────────────

# Base URL for transaction/account explorer links in the UI
NEXT_PUBLIC_STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet

# ────────────────────────────────────────────────────────────
# Wallet Configuration
# ────────────────────────────────────────────────────────────

# Comma-separated list of enabled wallets (order = display order)
# Supported: freighter, xbull, lobstr, hana, rabet, albedo
NEXT_PUBLIC_ENABLED_WALLETS=freighter,xbull,lobstr,hana

# ────────────────────────────────────────────────────────────
# Deployment Tooling (server-side / scripts only — not exposed to browser)
# ────────────────────────────────────────────────────────────

# Stellar CLI account alias used as the contract deployer
STELLAR_DEPLOYER_ACCOUNT=deployer

# Path to the contracts workspace (relative to repo root)
STELLAR_CONTRACT_PATH=./contracts

# Funded Stellar secret key for the deployment account
# WARNING: Keep this secret. Used only in CI/CD and deployment scripts.
STELLAR_DEPLOYER_SECRET_KEY=REPLACE_WITH_YOUR_SECRET_KEY

# ────────────────────────────────────────────────────────────
# Cron Bot / Automated Distribution (off-chain scheduler)
# ────────────────────────────────────────────────────────────

# Secret key used by the off-chain distribution bot to sign transactions
# Should be a dedicated keypair with minimal permissions
DISTRIBUTION_BOT_SECRET_KEY=REPLACE_WITH_BOT_SECRET_KEY

# How often the bot checks for due allowances (in seconds)
DISTRIBUTION_BOT_INTERVAL_SECONDS=60

# ────────────────────────────────────────────────────────────
# Observability & Monitoring
# ────────────────────────────────────────────────────────────

# Sentry DSN for error tracking (leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=

# Application environment tag for logging
NEXT_PUBLIC_APP_ENV=development

# Log level: "debug" | "info" | "warn" | "error"
LOG_LEVEL=info

# ────────────────────────────────────────────────────────────
# Feature Flags
# ────────────────────────────────────────────────────────────

# Enable real-time event polling in the Activity Feed
NEXT_PUBLIC_ENABLE_ACTIVITY_FEED=true

# Event polling interval in milliseconds (default: 5000ms)
NEXT_PUBLIC_ACTIVITY_POLL_INTERVAL_MS=5000

# Enable analytics page
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Enable savings goals feature
NEXT_PUBLIC_ENABLE_SAVINGS_GOALS=true

# ────────────────────────────────────────────────────────────
# Next.js App
# ────────────────────────────────────────────────────────────

# Public base URL of the deployed app (for og:url, sitemap, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# App name (used in meta tags + UI)
NEXT_PUBLIC_APP_NAME="Family Allowance Manager"
